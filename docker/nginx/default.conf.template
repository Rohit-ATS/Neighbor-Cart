server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location = / {
        try_files /harvestlink.html =404;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /harvestlink.html;
    }
}
