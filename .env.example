# Copy to .env and fill in locally. Never commit .env.
# Names only — values are provided per machine.

# Seat runtime (Claude Code seats)
ANTHROPIC_API_KEY=

# Optional Featherless-backed seat (e.g. the Breaker) — see BLUEPRINT step 5
FEATHERLESS_API_KEY=

# Optional local SQLite database location. Defaults to data/neighbor-cart.db.
# NEIGHBOR_CART_DB_PATH=/absolute/path/to/neighbor-cart.db
# Amazon Bedrock is called only by the Python API. Use an IAM role in
# production, or an AWS profile / `aws configure` locally. Never put AWS keys
# in Vite environment variables or commit them.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
